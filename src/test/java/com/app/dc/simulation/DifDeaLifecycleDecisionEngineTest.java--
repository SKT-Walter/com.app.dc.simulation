    /**
     * 验证弱交叉会进入观察态而不是直接开仓。
     */
    @Test
    public void shouldRedirectWeakLongCrossToPending() {
        LifecycleDecision decision = decide(neutralState(), samples(
                sample(0, -0.30, -0.10, -0.25, 100.0),
                sample(1, -0.15, -0.05, -0.08, 100.2),
                sample(2, 0.02, 0.00, 0.10, 100.5)
        ));

        Assert.assertEquals(LifecycleDecisionType.PENDING_LONG_LAUNCH, decision.getType());
        Assert.assertEquals("pending_by_weak_cross", decision.getReason());
    }

    /**
     * 验证 MA20 反向背景下的普通金叉会进入观察态。
     */
    @Test
    public void shouldRedirectLongCrossToPendingWhenMa20CounterTrend() {
        LifecycleDecision decision = decide(neutralState(), samples(
                sampleWithMa(0, -0.30, -0.10, -0.20, 100.0, 100.4, 99.7, 100.0, 100.0, 100.5, 101.0),
                sampleWithMa(1, -0.12, -0.06, -0.05, 100.1, 100.5, 99.8, 100.2, 100.1, 100.6, 100.7),
                sampleWithMa(2, 0.06, 0.00, 0.22, 100.3, 100.8, 100.0, 100.6, 100.2, 100.7, 100.4)
        ));

        Assert.assertEquals(LifecycleDecisionType.PENDING_LONG_LAUNCH, decision.getType());
        Assert.assertEquals("pending_by_ma20_counter_trend", decision.getReason());
    }

    /**
     * 验证单根大波幅的普通空仓开仓会被拦截。
     */
    @Test
    public void shouldBlockEntryWhenBarRangeTooLarge() {
        LifecycleDecision decision = decide(neutralState(), samples(
                sample(0, -0.60, -0.20, -0.30, 100.0),
                sample(1, -0.40, -0.10, -0.10, 100.3),
                sampleWithOhlc(2, 0.10, 0.00, 0.15, 100.0, 101.2, 99.8, 100.8)
        ));

        Assert.assertEquals(LifecycleDecisionType.NONE, decision.getType());
        Assert.assertEquals("entry_blocked_by_large_bar_range", decision.getReason());
    }

    /**
     * 验证压缩突破在候选记录后，下一根确认会真实成交。
     */
    @Test
    public void shouldEnterLongOnCompressionBreakoutConfirm() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        List<LifecycleIndicatorSample> triggerSamples = samples(
                sampleWithOhlc(0, -0.05, -0.03, -0.10, 100.0, 100.2, 99.8, 100.0),
                sampleWithOhlc(1, -0.04, -0.02, -0.08, 100.0, 100.2, 99.8, 100.0),
                sampleWithOhlc(2, -0.03, -0.01, -0.05, 100.0, 100.2, 99.8, 100.1),
                sampleWithOhlc(3, -0.02, -0.01, -0.03, 100.1, 100.2, 99.9, 100.0),
                sampleWithOhlc(4, -0.01, -0.01, -0.02, 100.0, 100.1, 99.9, 100.0),
                sampleWithOhlc(5, -0.01, -0.01, -0.01, 100.0, 100.1, 99.9, 100.0),
                sampleWithOhlc(6, 0.00, 0.00, 0.02, 100.0, 100.1, 99.9, 100.0),
                sampleWithOhlc(7, 0.01, 0.01, 0.03, 100.0, 100.1, 99.9, 100.0),
                sampleWithOhlc(8, 0.08, 0.02, 0.40, 100.1, 100.8, 100.0, 100.6)
        );
        LifecycleDecision triggerDecision = decide(state, triggerSamples);
        Assert.assertEquals(LifecycleDecisionType.NONE, triggerDecision.getType());
        Assert.assertEquals("compression_breakout_candidate_long", triggerDecision.getReason());
        stateTransitionEngine.apply(state, triggerSamples.get(triggerSamples.size() - 1),
                new LifecycleDecisionResult(triggerDecision, engine.decideWithTrace(
                        new LifecycleContext("difDeaLifecycle", "ETHUSDT", "5M", triggerSamples, defaultConfig(), state)).getTrace()));

        List<LifecycleIndicatorSample> confirmSamples = new ArrayList<LifecycleIndicatorSample>(triggerSamples);
        confirmSamples.add(sampleWithOhlc(9, 0.12, 0.03, 0.45, 100.4, 101.0, 100.3, 100.9));
        LifecycleDecision confirmDecision = decide(state, confirmSamples);
        Assert.assertEquals(LifecycleDecisionType.ENTER_LONG, confirmDecision.getType());
        Assert.assertEquals("compression_breakout_long", confirmDecision.getReason());
    }

    /**
     * 验证持仓反向交叉遇到大波幅时只平不反手。
     */
    @Test
    public void shouldLeaveLongWithoutReverseWhenReverseCrossBarTooLarge() {
        LifecycleState state = activeState(LifecyclePhase.LONG_ACTIVE);
        state.setDirection(LifecycleDirection.LONG);

        LifecycleDecision decision = decide(state, samples(
                sample(0, 0.50, 0.20, 0.25, 103.0),
                sample(1, 0.20, 0.15, 0.08, 102.5),
                sampleWithOhlc(2, -0.05, 0.00, -0.10, 102.0, 103.2, 101.8, 102.6)
        ));

        Assert.assertEquals(LifecycleDecisionType.LEAVE_LONG, decision.getType());
        Assert.assertEquals("dif_dea_cross_down", decision.getReason());
        Assert.assertFalse(decision.isReverseEntryAllowed());
    }

    /**
     * 验证压缩突破开多确认必须由当前阳线本体完成，不再接受上一根 open 兜底。
     */
    @Test
    public void shouldRequireCurrentBullishBodyForLongCompressionConfirm() {
        Assert.assertFalse(support.isLongCompressionConfirmPricePassed(
                sampleWithOhlc(1, 0.20, 0.10, 0.20, 99.5, 100.5, 99.4, 100.4),
                sampleWithOhlc(2, 0.30, 0.15, 0.40, 100.6, 100.8, 100.1, 100.2)));
    }

    /**
     * 验证压缩突破开空确认必须由当前阴线本体完成，不再接受上一根 open 兜底。
     */
    @Test
    public void shouldRequireCurrentBearishBodyForShortCompressionConfirm() {
        Assert.assertFalse(support.isShortCompressionConfirmPricePassed(
                sampleWithOhlc(1, -0.20, -0.10, -0.20, 100.5, 100.6, 99.5, 99.6),
                sampleWithOhlc(2, -0.30, -0.15, -0.40, 99.4, 99.9, 99.1, 99.7)));
    }

    /**
     * 执行一次默认配置决策。
     */
    private LifecycleDecision decide(LifecycleState state, List<LifecycleIndicatorSample> samples) {
        return decide(state, defaultConfig(), samples);
    }

    /**
     * 执行一次指定配置决策。
     */
    private LifecycleDecision decide(LifecycleState state, LifecycleConfig config, List<LifecycleIndicatorSample> samples) {
        return engine.decide(new LifecycleContext("difDeaLifecycle", "ETHUSDT", "5M", samples, config, state));
    }

    /**
     * 调用状态推进器推进一次状态。
     */
    private void updateBacktestState(LifecycleState state,
                                     LifecycleIndicatorSample latest,
                                     LifecycleDecision decision) {
        LifecycleDecisionResult result = new LifecycleDecisionResult(decision, new LifecycleTrace());
        stateTransitionEngine.apply(state, latest, result);
    }

    /**
     * 构造默认配置。
     */
    private LifecycleConfig defaultConfig() {
        return new LifecycleConfig("difDeaLifecycle", "ETHUSDT", "5M", 0.30, 0.0, 5, 4, 3, 2);
    }

    /**
     * 构造空仓状态。
     */
    private LifecycleState neutralState() {
        return new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
    }

    /**
     * 构造持仓状态。
     */
    private LifecycleState activeState(LifecyclePhase phase) {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(phase);
        return state;
    }

    /**
     * 构造样本列表。
     */
    private List<LifecycleIndicatorSample> samples(LifecycleIndicatorSample... samples) {
        List<LifecycleIndicatorSample> list = new ArrayList<LifecycleIndicatorSample>();
        for (LifecycleIndicatorSample sample : samples) {
            list.add(sample);
        }
        return list;
    }

    /**
     * 构造测试样本。
     */
    private LifecycleIndicatorSample sample(int index, double dif, double dea, double macd, double close) {
        double open = macd >= 0 ? close - 0.2 : close + 0.2;
        double high = Math.max(open, close) + 0.3;
        double low = Math.min(open, close) - 0.3;
        return new LifecycleIndicatorSample(index, "2026-07-01T00:" + String.format("%02d", index),
                dif, dea, macd, open, high, low, close, Double.NaN,
                Double.NaN, Double.NaN, Double.NaN, 0, Double.NaN, Double.NaN, Double.NaN);
    }

    /**
     * 构造带指定 OHLC 的测试样本。
     */
    private LifecycleIndicatorSample sampleWithOhlc(int index,
                                                    double dif,
                                                    double dea,
                                                    double macd,
                                                    double open,
                                                    double high,
                                                    double low,
                                                    double close) {
        return new LifecycleIndicatorSample(index, "2026-07-01T00:" + String.format("%02d", index),
                dif, dea, macd, open, high, low, close, Double.NaN,
                Double.NaN, Double.NaN, Double.NaN, 0, Double.NaN, Double.NaN, Double.NaN);
    }

    /**
     * 构造带 MA10/MA20 的测试样本。
     */
    private LifecycleIndicatorSample sampleWithMa(int index,
                                                  double dif,
                                                  double dea,
                                                  double macd,
                                                  double open,
                                                  double high,
                                                  double low,
                                                  double close,
                                                  double ma5,
                                                  double ma10,
                                                  double ma20) {
        return new LifecycleIndicatorSample(index, "2026-07-01T00:" + String.format("%02d", index),
                dif, dea, macd, open, high, low, close, Double.NaN,
                Double.NaN, Double.NaN, Double.NaN, 0, Double.NaN, ma5, ma10, ma20);
    }
}

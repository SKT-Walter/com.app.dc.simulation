package com.app.dc.simulation;

import com.app.dc.service.simulation.strategy.lifecycle.DifDeaLifecycleDecisionEngine;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleConfig;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleContext;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleDecision;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleDecisionType;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleDirection;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleIndicatorSample;
import com.app.dc.service.simulation.strategy.lifecycle.LifecyclePhase;
import com.app.dc.service.simulation.strategy.lifecycle.LifecycleState;
import com.app.dc.service.simulation.strategy.lifecycle.engine.LifecycleDecisionResult;
import com.app.dc.service.simulation.strategy.lifecycle.engine.LifecycleRuleSupport;
import com.app.dc.service.simulation.strategy.lifecycle.engine.LifecycleStateTransitionEngine;
import com.app.dc.service.simulation.strategy.lifecycle.trace.LifecycleTrace;
import com.app.dc.service.simulation.strategy.lifecycle.trace.LifecycleTraceFormatter;
import org.junit.Assert;
import org.junit.Test;

import java.util.ArrayList;
import java.util.List;

/**
 * 验证生命周期策略轻量版的核心行为。
 */
public class DifDeaLifecycleDecisionEngineTest {

    private final LifecycleRuleSupport support = new LifecycleRuleSupport();
    private final DifDeaLifecycleDecisionEngine engine =
            new DifDeaLifecycleDecisionEngine(support, new LifecycleTraceFormatter());
    private final LifecycleStateTransitionEngine stateTransitionEngine = new LifecycleStateTransitionEngine();

    /**
     * 验证金叉且不在粘合段时直接开多。
     */
    @Test
    public void shouldEnterLongOnGoldenCross() {
        LifecycleDecision decision = decide(neutralState(), samples(
                sample(0, -0.60, -0.20, -0.30, 100.0),
                sample(1, -0.40, -0.10, -0.10, 101.0),
                sample(2, 0.10, 0.00, 0.15, 102.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.ENTER_LONG, decision.getType());
        Assert.assertEquals("dif_dea_cross_up", decision.getReason());
    }

    /**
     * 验证死叉且不在粘合段时直接开空。
     */
    @Test
    public void shouldEnterShortOnDeadCross() {
        LifecycleDecision decision = decide(neutralState(), samples(
                sample(0, 0.60, 0.20, 0.30, 102.0),
                sample(1, 0.40, 0.10, 0.10, 101.0),
                sample(2, -0.10, 0.00, -0.15, 100.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.ENTER_SHORT, decision.getType());
        Assert.assertEquals("dif_dea_cross_down", decision.getReason());
    }

    /**
     * 验证粘合段会拦截空仓交叉开仓。
     */
    @Test
    public void shouldBlockEntryWhenBondingSegment() {
        LifecycleDecision decision = decide(neutralState(), new LifecycleConfig("difDeaLifecycle", "ETHUSDT", "5M",
                0.30, 0.0, 5, 4, 3, 2), samples(
                sample(0, -0.05, -0.02, -0.01, 100.0),
                sample(1, -0.04, -0.03, -0.01, 100.2),
                sample(2, -0.02, -0.02, 0.00, 100.1),
                sample(3, -0.01, -0.02, 0.01, 100.3),
                sample(4, 0.01, 0.00, 0.01, 100.4)
        ));

        Assert.assertEquals(LifecycleDecisionType.NONE, decision.getType());
        Assert.assertEquals("entry_blocked_by_dif_dea_bonding", decision.getReason());
    }

    /**
     * 验证多头持仓遇到反向死叉时离场。
     */
    @Test
    public void shouldLeaveLongOnDeadCross() {
        LifecycleState state = activeState(LifecyclePhase.LONG_ACTIVE);
        LifecycleDecision decision = decide(state, samples(
                sample(0, 0.60, 0.20, 0.20, 103.0),
                sample(1, 0.30, 0.15, 0.10, 102.0),
                sample(2, -0.10, 0.00, -0.05, 101.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.LEAVE_LONG, decision.getType());
        Assert.assertEquals("dif_dea_cross_down", decision.getReason());
    }

    /**
     * 验证空头持仓遇到反向金叉时离场。
     */
    @Test
    public void shouldLeaveShortOnGoldenCross() {
        LifecycleState state = activeState(LifecyclePhase.SHORT_ACTIVE);
        LifecycleDecision decision = decide(state, samples(
                sample(0, -0.60, -0.20, -0.20, 100.0),
                sample(1, -0.30, -0.15, -0.10, 101.0),
                sample(2, 0.10, 0.00, 0.05, 102.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.LEAVE_SHORT, decision.getType());
        Assert.assertEquals("dif_dea_cross_up", decision.getReason());
    }

    /**
     * 验证多头持仓在 MACD 与 close 同步走弱时触发策略离场。
     */
    @Test
    public void shouldLeaveLongWhenMacdAndCloseWeakening() {
        LifecycleState state = activeState(LifecyclePhase.LONG_ACTIVE);
        LifecycleDecision decision = decide(state, samples(
                sample(0, 1.00, 0.50, 0.80, 105.0),
                sample(1, 1.00, 0.50, 0.70, 104.0),
                sample(2, 1.00, 0.50, 0.60, 103.0),
                sample(3, 1.00, 0.50, 0.50, 102.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.LEAVE_LONG, decision.getType());
        Assert.assertEquals("macd_shrinking_and_close_weakening", decision.getReason());
    }

    /**
     * 验证空头持仓在 MACD 与 close 同步走强时触发策略离场。
     */
    @Test
    public void shouldLeaveShortWhenMacdAndCloseStrengthening() {
        LifecycleState state = activeState(LifecyclePhase.SHORT_ACTIVE);
        LifecycleDecision decision = decide(state, samples(
                sample(0, -1.00, -0.50, -0.80, 100.0),
                sample(1, -1.00, -0.50, -0.70, 101.0),
                sample(2, -1.00, -0.50, -0.60, 102.0),
                sample(3, -1.00, -0.50, -0.50, 103.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.LEAVE_SHORT, decision.getType());
        Assert.assertEquals("macd_recovering_and_close_strengthening", decision.getReason());
    }

    /**
     * 验证反向交叉过近时会被粘合保护拦住。
     */
    @Test
    public void shouldBlockReverseCrossWhenGapIsTooSmall() {
        LifecycleState state = activeState(LifecyclePhase.LONG_ACTIVE);
        LifecycleDecision decision = decide(state, new LifecycleConfig("difDeaLifecycle", "ETHUSDT", "5M",
                0.30, 0.05, 5, 4, 3, 2), samples(
                sample(0, 0.08, 0.04, 0.02, 103.0),
                sample(1, 0.04, 0.03, 0.01, 102.0),
                sample(2, 0.02, 0.03, -0.01, 101.0)
        ));

        Assert.assertEquals(LifecycleDecisionType.NONE, decision.getType());
        Assert.assertEquals("reverse_cross_blocked_by_dif_dea_bonding", decision.getReason());
    }

    /**
     * 验证多头离场后状态回到空闲。
     */
    @Test
    public void shouldEnterPendingLongAfterLeaveLong() {
        LifecycleState state = activeState(LifecyclePhase.LONG_ACTIVE);
        state.setDirection(LifecycleDirection.LONG);
        LifecycleDecision decision = LifecycleDecision.of(LifecycleDecisionType.LEAVE_LONG,
                "macd_shrinking_and_close_weakening");

        updateBacktestState(state, sample(9, 1.00, 0.50, 0.50, 102.0), decision);

        Assert.assertEquals(LifecyclePhase.PENDING_LONG_LAUNCH, state.getPhase());
        Assert.assertEquals(LifecycleDirection.LONG, state.getDirection());
    }

    /**
     * 验证空头离场后状态回到空闲。
     */
    @Test
    public void shouldEnterPendingShortAfterLeaveShort() {
        LifecycleState state = activeState(LifecyclePhase.SHORT_ACTIVE);
        state.setDirection(LifecycleDirection.SHORT);
        LifecycleDecision decision = LifecycleDecision.of(LifecycleDecisionType.LEAVE_SHORT,
                "macd_recovering_and_close_strengthening");

        updateBacktestState(state, sample(8, -1.00, -0.50, -0.50, 103.0), decision);

        Assert.assertEquals(LifecyclePhase.PENDING_SHORT_LAUNCH, state.getPhase());
        Assert.assertEquals(LifecycleDirection.SHORT, state.getDirection());
    }

    /**
     * 验证多头观察期出现反向交叉且被粘合拦截后，会结束旧观察并回到空仓。
     */
    @Test
    public void shouldResetPendingLongToNeutralWhenReverseCrossBlockedByBonding() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_LONG_LAUNCH);
        state.setDirection(LifecycleDirection.LONG);
        LifecycleDecision decision = LifecycleDecision.none("entry_blocked_by_dif_dea_bonding");
        LifecycleTrace trace = new LifecycleTrace().put("pendingTerminatedByReverseCross", true);

        stateTransitionEngine.apply(state, sample(10, -0.01, 0.00, -0.01, 100.0),
                new LifecycleDecisionResult(decision, trace));

        Assert.assertEquals(LifecyclePhase.NEUTRAL, state.getPhase());
        Assert.assertEquals(LifecycleDirection.NONE, state.getDirection());
    }

    /**
     * 验证多头观察态只要满足 MACD、close 和间隔条件即可二次启动，不再依赖结构确认。
     */
    @Test
    public void shouldEnterLongRelaunchWithoutStructureConfirmation() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_LONG_LAUNCH);
        state.setDirection(LifecycleDirection.LONG);
        state.setPendingStartIndex(0);
        state.setPendingStartBarTime("2026-07-01T00:00");

        LifecycleDecision decision = decide(state, samples(
                sampleWithOhlc(0, 0.20, 0.10, 0.05, 100.2, 100.4, 99.9, 100.0),
                sampleWithOhlc(1, 0.18, 0.12, 0.04, 100.1, 100.3, 99.95, 100.05),
                sampleWithOhlc(2, 0.19, 0.13, 0.06, 100.2, 100.5, 100.0, 100.2),
                sampleWithOhlc(3, 0.21, 0.14, 0.09, 100.3, 100.8, 100.1, 100.5),
                sampleWithOhlc(4, 0.24, 0.15, 0.14, 100.6, 101.1, 100.2, 100.9)
        ));

        Assert.assertEquals(LifecycleDecisionType.ENTER_LONG, decision.getType());
        Assert.assertEquals("relaunch_long_after_strategy_exit", decision.getReason());
    }

    /**
     * 验证多头观察态方向破坏后会结束本轮观察。
     */
    @Test
    public void shouldKeepPendingLongWhenDirectionBrokenButNoReverseCross() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_LONG_LAUNCH);
        state.setDirection(LifecycleDirection.LONG);
        state.setPendingStartIndex(0);
        state.setPendingStartBarTime("2026-07-01T00:00");

        LifecycleDecision decision = decide(state, samples(
                sample(0, 0.20, 0.10, 0.05, 100.0),
                sample(1, 0.18, 0.12, 0.04, 99.8),
                sample(2, 0.16, 0.15, 0.01, 99.9),
                sample(3, 0.10, 0.14, -0.02, 99.7)
        ));

        Assert.assertEquals(LifecycleDecisionType.PENDING_LONG_LAUNCH, decision.getType());
        Assert.assertEquals("pending_launch_tracking", decision.getReason());
    }

    /**
     * 验证空头观察态只要满足 MACD、close 和间隔条件即可二次启动，不再依赖结构确认。
     */
    @Test
    public void shouldEnterShortRelaunchWithoutStructureConfirmation() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_SHORT_LAUNCH);
        state.setDirection(LifecycleDirection.SHORT);
        state.setPendingStartIndex(0);
        state.setPendingStartBarTime("2026-07-01T00:00");

        LifecycleDecision decision = decide(state, samples(
                sampleWithOhlc(0, -0.20, -0.10, -0.05, 99.8, 100.1, 99.6, 100.0),
                sampleWithOhlc(1, -0.18, -0.12, -0.04, 99.9, 100.1, 99.7, 99.95),
                sampleWithOhlc(2, -0.19, -0.13, -0.06, 99.8, 99.9, 99.5, 99.8),
                sampleWithOhlc(3, -0.21, -0.14, -0.09, 99.7, 99.8, 99.2, 99.5),
                sampleWithOhlc(4, -0.24, -0.15, -0.14, 99.4, 99.5, 98.9, 99.1)
        ));

        Assert.assertEquals(LifecycleDecisionType.ENTER_SHORT, decision.getType());
        Assert.assertEquals("relaunch_short_after_strategy_exit", decision.getReason());
    }

    /**
     * 验证空头观察态方向破坏后会结束本轮观察。
     */
    @Test
    public void shouldKeepPendingShortWhenDirectionBrokenButNoReverseCross() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_SHORT_LAUNCH);
        state.setDirection(LifecycleDirection.SHORT);
        state.setPendingStartIndex(0);
        state.setPendingStartBarTime("2026-07-01T00:00");

        LifecycleDecision decision = decide(state, samples(
                sample(0, -0.20, -0.10, -0.05, 100.0),
                sample(1, -0.18, -0.12, -0.04, 100.2),
                sample(2, -0.16, -0.15, -0.01, 100.1),
                sample(3, -0.10, -0.14, 0.02, 100.3)
        ));

        Assert.assertEquals(LifecycleDecisionType.PENDING_SHORT_LAUNCH, decision.getType());
        Assert.assertEquals("pending_launch_tracking", decision.getReason());
    }

    /**
     * 验证多头观察态即使结构被破坏，只要高频完整版的核心条件满足，仍可二次启动。
     */
    @Test
    public void shouldEnterLongRelaunchWhenStructureBrokenButCoreSignalsPass() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_LONG_LAUNCH);
        state.setDirection(LifecycleDirection.LONG);
        state.setPendingStartIndex(0);
        state.setPendingStartBarTime("2026-07-01T00:00");

        LifecycleDecision decision = decide(state, samples(
                sampleWithOhlc(0, 0.20, 0.10, 0.05, 100.2, 100.4, 99.9, 100.0),
                sampleWithOhlc(1, 0.18, 0.12, 0.04, 100.1, 100.3, 99.7, 100.05),
                sampleWithOhlc(2, 0.19, 0.13, 0.06, 100.2, 100.5, 99.6, 100.2),
                sampleWithOhlc(3, 0.21, 0.14, 0.09, 100.3, 100.8, 99.5, 100.5),
                sampleWithOhlc(4, 0.24, 0.15, 0.14, 100.6, 101.1, 99.4, 100.9)
        ));

        Assert.assertEquals(LifecycleDecisionType.ENTER_LONG, decision.getType());
        Assert.assertEquals("relaunch_long_after_strategy_exit", decision.getReason());
    }

    /**
     * 验证空头观察态即使结构被破坏，只要高频完整版的核心条件满足，仍可二次启动。
     */
    @Test
    public void shouldEnterShortRelaunchWhenStructureBrokenButCoreSignalsPass() {
        LifecycleState state = new LifecycleState("difDeaLifecycle", "ETHUSDT", "5M");
        state.setPhase(LifecyclePhase.PENDING_SHORT_LAUNCH);
        state.setDirection(LifecycleDirection.SHORT);
        state.setPendingStartIndex(0);
        state.setPendingStartBarTime("2026-07-01T00:00");

        LifecycleDecision decision = decide(state, samples(
                sampleWithOhlc(0, -0.20, -0.10, -0.05, 99.8, 100.1, 99.6, 100.0),
                sampleWithOhlc(1, -0.18, -0.12, -0.04, 99.9, 100.4, 99.7, 99.95),
                sampleWithOhlc(2, -0.19, -0.13, -0.06, 99.8, 100.5, 99.5, 99.8),
                sampleWithOhlc(3, -0.21, -0.14, -0.09, 99.7, 100.6, 99.2, 99.5),
                sampleWithOhlc(4, -0.24, -0.15, -0.14, 99.4, 100.7, 98.9, 99.1)
        ));

        Assert.assertEquals(LifecycleDecisionType.ENTER_SHORT, decision.getType());
        Assert.assertEquals("relaunch_short_after_strategy_exit", decision.getReason());
